# Copy to .env (never committed) and fill in.

# MLflow: a local SQLite file is enough for tracking and the Model Registry.
# Point it to a tracking server if you have one, e.g. http://localhost:5000
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Token for POST /admin/reload (swap the served model after a promotion or a rollback).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty to disable the endpoint.
ADMIN_TOKEN=

# API port used by `make serve`
PORT=8000
